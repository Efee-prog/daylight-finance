# Daylight environment variables.
#
# Copy this file to .env.local and fill in the values for your own Supabase
# project. .env.local is git-ignored; never commit real keys.
#
#   cp .env.example .env.local
#
# For local development `npx supabase start` prints the URL and the anon key
# for the containerised stack, and those are the values to paste here.

# Public Supabase endpoint. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable anon key. Safe to expose to the browser *only* because Row Level
# Security is enabled on every table; it carries no privileges of its own.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key

# Service role key — NEVER set this in a NEXT_PUBLIC_ variable and never ship
# it to the browser. It bypasses Row Level Security entirely. Daylight's
# application code does not use it; it is listed here only because local
# migration and seed tooling may need it.
# SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL, used to build auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
